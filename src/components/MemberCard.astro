---
import type { Member } from '../data/band';
import { useT, type Lang } from '../i18n/ui';
interface Props { member: Member; lang: Lang; index: number }
const { member, lang, index } = Astro.props;
const t = useT(lang);
// Placeholder icons until the band's own character drawings are ready.
const icon = { vocals: '🎤', sax: '🎷', keys: '🎹', guitar1: '🎸', guitar2: '🎸', bass: '🎸', drums: '🥁', percussion: '🪘' }[member.instrument];
const tilt = index % 2 ? 'rotate-1' : '-rotate-1';
---
<article class:list={['sticker wobble overflow-hidden', tilt]}>
  <div class="relative grid aspect-[4/3] place-items-center border-b-3 border-ink" style={`background:${member.color}`}>
    <span class="text-6xl drop-shadow-[3px_3px_0_rgba(58,20,12,0.6)]" aria-hidden="true">{icon}</span>
  </div>
  <div class="p-4">
    <h3 class="text-xl">{member.name}</h3>
    <p class="text-sm font-bold uppercase tracking-wide text-muted">{t(`instrument.${member.instrument}`)}</p>
  </div>
</article>
