---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="sky border-b-3 border-ink">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="text-5xl text-[#3a140c] dark:text-[#fdf3e1] md:text-6xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg font-medium text-[#3a140c] dark:text-[#fdf3e1]">{intro}</p>}
  </div>
</section>
