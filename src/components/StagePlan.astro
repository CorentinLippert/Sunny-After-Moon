---
// Stage plan drawn in the site palette. Audience is at the bottom.
// Positions follow the band's stage plan; channel numbers match src/data/tech.ts.
import type { TechDict } from '../i18n/tech';

interface Props { t: TechDict; class?: string }
const { t, class: cls } = Astro.props;
const p = t.plan;

const ink = '#3a140c';
const spots = [
  { x: 170, y: 140, name: 'Tomas', line: `${p.perc} · ${p.fx}`, ch: '18–22', color: '#f39a1e' },
  { x: 500, y: 135, name: 'Wim', line: p.drums, ch: '1–9', color: '#e2622a' },
  { x: 830, y: 140, name: 'Tijl', line: `${p.keys} · ${p.vox} 4`, ch: '14–15 · 27', color: '#3f8f86', light: true },
  { x: 300, y: 285, name: 'Simon', line: p.bass, ch: '10–11', color: '#b2cc3c' },
  { x: 690, y: 285, name: 'Hans', line: `${p.guitar} · ${p.vox} 4`, ch: '13 · 27', color: '#4fa37e' },
  { x: 190, y: 430, name: 'Corentin', line: `${p.sax} · ${p.vox} 3`, ch: '16–17 · 26', color: '#fcc400' },
  { x: 500, y: 430, name: 'Yorick', line: `${p.vox} 1 · ${p.djembe}`, ch: '23–24', color: '#6cbc92' },
  { x: 810, y: 430, name: 'Sam', line: `${p.guitar} · ${p.vox} 2`, ch: '12 · 25', color: '#ffec00' },
];
const amps = [
  { x: 300, y: 48, w: 150, h: 38, label: p.bassAmp },
  { x: 722, y: 48, w: 190, h: 38, label: `${p.gtrAmp} (Hans)` },
  { x: 960, y: 400, w: 38, h: 190, label: `${p.gtrAmp} (Sam)`, vertical: true },
];
const wedges = [
  { x: 170, y: 212, n: 1 }, { x: 330, y: 212, n: 2 }, { x: 830, y: 212, n: 3 },
  { x: 190, y: 515, n: 4 }, { x: 500, y: 515, n: 5 }, { x: 810, y: 515, n: 6 },
];
const pw = 230, ph = 84;
---
<svg viewBox="0 0 1000 640" class:list={['h-auto w-full', cls]} role="img" aria-label={t.stagePlan} font-family="'DM Sans', system-ui, sans-serif">
  <rect x="6" y="6" width="988" height="560" rx="22" fill="#fff7dc" stroke={ink} stroke-width="4" />
  <!-- drum riser -->
  <rect x="380" y="24" width="240" height="180" rx="10" fill="#f6dfa0" stroke={ink} stroke-width="2" stroke-dasharray="8 6" />
  <text x="500" y="46" text-anchor="middle" font-size="14" fill={ink} opacity="0.75">{t.drumRiser}</text>

  {amps.map((a) => (
    <g>
      <rect x={a.x - a.w / 2} y={a.y - a.h / 2} width={a.w} height={a.h} rx="6" fill="#0f2a26" stroke={ink} stroke-width="2" />
      {a.vertical
        ? <text x={a.x} y={a.y} text-anchor="middle" dominant-baseline="middle" font-size="14" fill="#fdf3e1" transform={`rotate(-90 ${a.x} ${a.y})`}>{a.label}</text>
        : <text x={a.x} y={a.y + 1} text-anchor="middle" dominant-baseline="middle" font-size="15" fill="#fdf3e1">{a.label}</text>}
    </g>
  ))}

  {wedges.map((w) => (
    <g>
      <path d={`M${w.x - 42} ${w.y - 14} h84 l-12 28 h-60 z`} fill="#96261b" stroke={ink} stroke-width="2" />
      <text x={w.x} y={w.y + 2} text-anchor="middle" dominant-baseline="middle" font-size="16" font-weight="700" fill="#fdf3e1">M{w.n}</text>
    </g>
  ))}

  {spots.map((s) => (
    <g>
      <rect x={s.x - pw / 2 + 5} y={s.y - ph / 2 + 5} width={pw} height={ph} rx="18" fill={ink} />
      <rect x={s.x - pw / 2} y={s.y - ph / 2} width={pw} height={ph} rx="18" fill={s.color} stroke={ink} stroke-width="3" />
      <text x={s.x} y={s.y - 14} text-anchor="middle" font-family="'Lilita One', system-ui, sans-serif" font-size="25" fill={s.light ? '#fdf3e1' : ink}>{s.name}</text>
      <text x={s.x} y={s.y + 10} text-anchor="middle" font-size="16" fill={s.light ? '#fdf3e1' : ink}>{s.line}</text>
      <text x={s.x} y={s.y + 31} text-anchor="middle" font-size="15" font-weight="700" fill={s.light ? '#fdf3e1' : ink}>{t.ch} {s.ch}</text>
    </g>
  ))}

  <!-- audience -->
  <rect x="6" y="582" width="988" height="52" rx="16" fill="#ce460a" stroke={ink} stroke-width="3" />
  <text x="500" y="609" text-anchor="middle" dominant-baseline="middle" font-family="'Lilita One', system-ui, sans-serif" font-size="26" fill="#fdf3e1" letter-spacing="3">▼ {t.audience.toUpperCase()} ▼</text>
</svg>
