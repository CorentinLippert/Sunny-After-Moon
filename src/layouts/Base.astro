---
import '../styles/global.css';
import { languages, langs, localePath, useT, type Lang } from '../i18n/ui';
import { links } from '../data/band';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const t = useT(lang);

// Path of this page without its language prefix, used by the language switch.
const rest = Astro.url.pathname.replace(/^\/(nl|fr)(?=\/|$)/, '') || '/';
const nav = [
  ['/', t('nav.home')],
  ['/music/', t('nav.music')],
  ['/band/', t('nav.band')],
  ['/live/', t('nav.live')],
  ['/videos/', t('nav.videos')],
  ['/booking/', t('nav.booking')],
] as const;
const pageTitle = title ? `${title} · Sunny After Moon` : 'Sunny After Moon';
const current = (p: string) => (p === '/' ? rest === '/' : rest.startsWith(p));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t('meta.description')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t('meta.description')} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/images/logo.png', Astro.site)} />
    <meta name="theme-color" content="#fcc400" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, rest), Astro.site)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Lilita+One&display=swap" rel="stylesheet" />
    <script is:inline>
      // Pick day or night before paint: saved choice, else the system setting.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('sam-theme'); } catch (e) {}
        var night = saved ? saved === 'night' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = night ? 'night' : 'day';
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 border-b-3 border-ink bg-bg/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
        <a href={localePath(lang, '/')} class="flex items-center gap-2 font-display text-xl leading-none sm:text-2xl">
          <img src="/images/logo-160.webp" alt="" width="44" height="44" class="h-10 w-10 shrink-0 rounded-full sm:h-11 sm:w-11" />
          <span>Sunny <span class="text-sun dark:text-gold">After</span> Moon</span>
        </a>
        <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
          {nav.map(([p, label]) => (
            <a
              href={localePath(lang, p)}
              class:list={['rounded-full px-3 py-1.5 font-medium hover:bg-gold/40', current(p) && 'bg-gold text-[#3a140c]']}
              aria-current={current(p) ? 'page' : undefined}
            >{label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2 lg:ml-2">
          <div class="flex overflow-hidden rounded-full border-2 border-ink text-sm font-bold">
            {langs.map((l) => (
              <a href={localePath(l, rest)} hreflang={l} class:list={['px-2 py-1', l === lang ? 'bg-ink text-bg' : 'hover:bg-gold/40']}>{languages[l]}</a>
            ))}
          </div>
          <button id="theme-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-full border-2 border-ink bg-card" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" fill="#fcc400"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="#fbf3cf" stroke="currentColor" stroke-width="2"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <button id="menu-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-full border-2 border-ink bg-card lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="hidden border-t-2 border-ink px-4 pb-4 lg:hidden" aria-label="Main">
        <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-2 pt-3">
          {nav.map(([p, label]) => (
            <li><a href={localePath(lang, p)} class:list={['block rounded-xl border-2 border-ink px-3 py-2 font-display text-lg', current(p) ? 'bg-gold text-[#3a140c]' : 'bg-card']}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t-3 border-ink bg-night text-[#fdf3e1]">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <img src="/images/logo-160.webp" alt="" width="72" height="72" class="h-16 w-16 rounded-full sm:h-[72px] sm:w-[72px]" loading="lazy" />
          <div>
          <p class="font-display text-2xl">Sunny <span class="text-gold">After</span> Moon</p>
          <p class="text-sm opacity-80">{t('footer.made')} · <a class="underline" href={`mailto:${links.email}`}>{links.email}</a></p>
          </div>
        </div>
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-wide opacity-80">{t('footer.follow')}</p>
          <ul class="flex flex-wrap gap-2 text-sm font-bold">
            <li><a class="rounded-full border-2 border-[#fdf3e1] px-3 py-1 hover:bg-gold hover:text-[#3a140c]" href={links.instagram}>Instagram</a></li>
            <li><a class="rounded-full border-2 border-[#fdf3e1] px-3 py-1 hover:bg-gold hover:text-[#3a140c]" href={links.spotify}>Spotify</a></li>
            <li><a class="rounded-full border-2 border-[#fdf3e1] px-3 py-1 hover:bg-gold hover:text-[#3a140c]" href={links.bandcamp}>Bandcamp</a></li>
            <li><a class="rounded-full border-2 border-[#fdf3e1] px-3 py-1 hover:bg-gold hover:text-[#3a140c]" href={links.youtube}>YouTube</a></li>
            <li><a class="rounded-full border-2 border-[#fdf3e1] px-3 py-1 hover:bg-gold hover:text-[#3a140c]" href={links.facebook}>Facebook</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'night' ? 'day' : 'night';
        root.dataset.theme = next;
        try { localStorage.setItem('sam-theme', next); } catch {}
      });
      const menuBtn = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-nav');
      menuBtn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
