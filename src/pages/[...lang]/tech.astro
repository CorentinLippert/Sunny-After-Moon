---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import StagePlan from '../../components/StagePlan.astro';
import InputList from '../../components/InputList.astro';
import { links } from '../../data/band';
import { channels, crew, monitors, power, pdfFile } from '../../data/tech';
import { tech, langNames } from '../../i18n/tech';
import { langPaths, langs, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = tech[lang];
const sockets = power.reduce((n, p) => n + p.count, 0);
const facts = [8, channels.length, monitors.length, sockets];
---
<Base lang={lang} title={t.title}>
  <PageHeader title={t.title} intro={t.intro} />

  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
    <figure class="sticker overflow-hidden p-0">
      <img src="/images/band-live-1200.webp" srcset="/images/band-live-1200.webp 1200w, /images/band-live.webp 2048w" sizes="(min-width: 1024px) 680px, 100vw" alt="" width="1200" height="800" class="block h-auto w-full" />
      <figcaption class="border-t-3 border-ink px-4 py-2 text-xs text-muted">{t.photoCredit}</figcaption>
    </figure>
    <div>
      <p class="text-lg">{t.welcome}</p>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {facts.map((n, i) => (
          <div class="sticker px-4 py-3">
            <dt class="sr-only">{t.facts[i]}</dt>
            <dd><span class="font-display text-4xl text-sun dark:text-gold">{n}</span> <span class="font-medium">{t.facts[i]}</span></dd>
          </div>
        ))}
      </dl>
      <a href={pdfFile(lang)} download class="btn mt-6 bg-gold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16"/></svg>
        {t.download}
      </a>
      <p class="mt-3 text-sm">
        {t.otherLangs}{' '}
        {langs.filter((l) => l !== lang).map((l, i) => (
          <>{i > 0 && ' · '}<a class="font-bold underline" href={pdfFile(l)} download hreflang={l}>{langNames[lang][l]}</a></>
        ))}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6">
    <h2 class="text-4xl">{t.stagePlan}</h2>
    <div class="sticker mt-5 p-3 sm:p-5">
      <StagePlan t={t} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-4xl">{t.inputList}</h2>
    <div class="sticker mt-5 overflow-hidden p-0 pb-4">
      <InputList t={t} />
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-6 md:grid-cols-3">
    <div class="sticker p-6">
      <h2 class="text-2xl">{t.monitorsTitle}</h2>
      <p class="mt-2">{t.monitorsText}</p>
      <ul class="mt-3 space-y-1">
        {monitors.map((m) => <li><span class="font-display text-sun dark:text-gold">M{m.n}</span> {m.who} <span class="text-muted">· {t[m.spot]}</span></li>)}
      </ul>
    </div>
    <div class="sticker p-6">
      <h2 class="text-2xl">{t.powerTitle}</h2>
      <p class="mt-2">{t.powerText}</p>
      <ul class="mt-3 space-y-1">
        {power.map((p) => <li><span class="font-display text-sun dark:text-gold">{p.count}×</span> {p.who} <span class="text-muted">· {t.powerWhat[p.what]}</span></li>)}
      </ul>
    </div>
    <div class="sticker p-6">
      <h2 class="text-2xl">{t.crew}</h2>
      <ul class="mt-3 space-y-1">
        {crew.map((c) => <li><span class="font-bold">{c.name}</span><br /><span class="text-sm text-muted">{t.roles[c.role]}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="sticker bg-gold! p-6 text-[#3a140c]">
      <h2 class="text-3xl">{t.contactTitle}</h2>
      <p class="mt-2 max-w-2xl">{t.contactText}</p>
      <a class="mt-3 inline-block break-all font-display text-2xl underline decoration-3 underline-offset-4" href={`mailto:${links.email}`}>{links.email}</a>
    </div>
  </section>
</Base>
