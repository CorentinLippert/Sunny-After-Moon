---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { links, youtubeEmbed } from '../../data/band';
import { langPaths, useT, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<Base lang={lang} title={t('videos.title')}>
  <PageHeader title={t('videos.title')} intro={t('videos.intro')} />
  <section class="mx-auto max-w-5xl px-4 py-14">
    <div class="sticker overflow-hidden">
      <iframe title="YouTube" src={youtubeEmbed} class="block aspect-video w-full" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
    <a class="btn mt-6 bg-coral" href={links.youtube}>{t('videos.channel')} ↗</a>
  </section>
</Base>
