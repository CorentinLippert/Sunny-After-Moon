---
// Printable A4 version of the tech rider. scripts/rider-pdf.mjs turns it into
// public/downloads/sunny-after-moon-tech-rider-<lang>.pdf. Not linked from the site.
import '../../../styles/global.css';
import StagePlan from '../../../components/StagePlan.astro';
import InputList from '../../../components/InputList.astro';
import { links } from '../../../data/band';
import { crew, monitors, power } from '../../../data/tech';
import { tech } from '../../../i18n/tech';
import { langPaths, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = tech[lang];
const site = 'sunnyaftermoon.com';
---
<!doctype html>
<html lang={lang} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Sunny After Moon · {t.title}</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Lilita+One&display=swap" rel="stylesheet" />
    <style>
      @page { size: A4; margin: 0; }
      html, body { background: #fff; }
      .page { width: 210mm; height: 297mm; padding: 13mm 14mm 11mm; display: flex; flex-direction: column; overflow: hidden; page-break-after: always; break-after: page; }
      .page:last-child { page-break-after: auto; break-after: auto; }
      .band { background: linear-gradient(90deg, #ffec00, #fcc400 45%, #f08a2c); }
      h2 { font-size: 20px; margin-bottom: 6px; }
      @media screen { body { background: #ddd; } .page { background: #fff; margin: 10mm auto; box-shadow: 0 2px 12px rgba(0,0,0,.2); } }
    </style>
  </head>
  <body class="text-[12px]">
    <section class="page">
      <header class="band flex items-center gap-4 rounded-2xl border-3 border-ink px-5 py-3">
        <img src="/images/logo-160.webp" alt="" width="64" height="64" class="h-16 w-16 rounded-full" />
        <div class="flex-1">
          <p class="font-display text-[30px] leading-none text-[#3a140c]">Sunny <span class="text-sun">After</span> Moon</p>
          <p class="font-display text-[18px] text-[#3a140c]">{t.title}</p>
        </div>
        <div class="text-right text-[11px] font-medium text-[#3a140c]">
          <p>{links.email}</p>
          <p>{site}</p>
          <p class="opacity-80">{t.updated}</p>
        </div>
      </header>

      <p class="mt-4 text-[12.5px]">{t.welcome}</p>

      <h2 class="mt-4">{t.crew}</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-0.5">
        {crew.map((c) => <li><span class="font-bold">{c.name}</span> <span class="text-muted">· {t.roles[c.role]}</span></li>)}
      </ul>

      <h2 class="mt-4">{t.stagePlan}</h2>
      <StagePlan t={t} />

      <div class="mt-4 grid grid-cols-2 gap-5">
        <div>
          <h2>{t.monitorsTitle}</h2>
          <p>{t.monitorsText}</p>
          <ul class="mt-1 grid grid-cols-2">
            {monitors.map((m) => <li><span class="font-display text-sun">M{m.n}</span> {m.who}</li>)}
          </ul>
        </div>
        <div>
          <h2>{t.powerTitle}</h2>
          <p>{t.powerText}</p>
          <ul class="mt-1">
            {power.map((p) => <li><span class="font-display text-sun">{p.count}×</span> {p.who} <span class="text-muted">· {t.powerWhat[p.what]}</span></li>)}
          </ul>
        </div>
      </div>
      <footer class="mt-auto flex justify-between border-t-2 border-ink pt-2 text-[10px] text-muted"><span>Sunny After Moon · {t.title}</span><span>1 / 2</span></footer>
    </section>

    <section class="page">
      <h2 class="text-[24px]">{t.inputList}</h2>
      <div class="overflow-hidden rounded-xl border-2 border-ink">
        <InputList t={t} compact />
      </div>

      <div class="mt-5 rounded-2xl border-3 border-ink bg-gold p-4 text-[#3a140c]">
        <h2>{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <p class="mt-1 font-display text-[18px]">{links.email} · {site}</p>
      </div>
      <footer class="mt-auto flex justify-between border-t-2 border-ink pt-2 text-[10px] text-muted"><span>Sunny After Moon · {t.title}</span><span>2 / 2</span></footer>
    </section>
  </body>
</html>
