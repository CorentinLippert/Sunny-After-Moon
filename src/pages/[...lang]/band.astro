---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import MemberCard from '../../components/MemberCard.astro';
import BandPhoto from '../../components/BandPhoto.astro';
import { members } from '../../data/band';
import { langPaths, useT, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<Base lang={lang} title={t('band.title')}>
  <PageHeader title={t('band.title')} intro={t('band.intro')} />
  <section class="mx-auto max-w-6xl px-4 py-14">
    <BandPhoto alt={t('band.photoAlt')} class="mb-12" eager />
    <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
      {members.map((m, i) => <MemberCard member={m} lang={lang} index={i} />)}
    </div>
  </section>
</Base>
