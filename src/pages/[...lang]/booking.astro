---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { links } from '../../data/band';
import { langPaths, useT, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<Base lang={lang} title={t('booking.title')}>
  <PageHeader title={t('booking.title')} intro={t('booking.intro')} />
  <section class="mx-auto grid max-w-5xl gap-6 px-4 py-14 md:grid-cols-2">
    <div class="sticker bg-gold p-6 text-[#3a140c] md:col-span-2">
      <h2 class="text-3xl">{t('booking.mail')}</h2>
      <a class="mt-3 inline-block break-all font-display text-2xl underline decoration-3 underline-offset-4 sm:text-3xl" href={`mailto:${links.email}`}>{links.email}</a>
    </div>
    <div class="sticker p-6">
      <h2 class="text-2xl">{t('booking.bioShort')}</h2>
      <p class="mt-3">{t('booking.bioShortText')}</p>
    </div>
    <div class="sticker p-6">
      <h2 class="text-2xl">{t('booking.press')}</h2>
      <p class="mt-3">{t('booking.pressText')}</p>
    </div>
    <div class="sticker p-6 md:col-span-2">
      <h2 class="text-2xl">{t('booking.bioLong')}</h2>
      <p class="mt-3">{t('booking.bioLongText')}</p>
    </div>
  </section>
</Base>
